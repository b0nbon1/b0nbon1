{
  "name": "bonvic-blog",
  "version": "1.0.0",
  "description": "Bonvic's personal blog built with Hugo and Tailwind CSS",
  "scripts": {
    "install-tailwind": "curl -sLO https://github.com/tailwindlabs/tailwindcss/releases/latest/download/tailwindcss-linux-x64 && chmod +x tailwindcss-linux-x64",
    "build:css": "npx tailwindcss -i themes/bon/assets/css/main.css -o themes/bon/assets/css/output.css --minify",
    "build:css:watch": "npx tailwindcss -i themes/bon/assets/css/main.css -o themes/bon/assets/css/output.css --watch",
    "build": "npm run build:css && hugo --gc --minify",
    "dev": "npm run build:css && hugo server -D"
  }
}
